# Copiar para .env e preencher. O .env nunca vai para o git.
# São as mesmas credenciais do Azores Cyber 360 (a mesma chave do XSIAM).

# --- Cortex XSIAM ----------------------------------------------------------
# A chave tem de poder correr XQL sobre o dataset cloudflare_waf_raw.
CORTEX_API_URL=
CORTEX_API_KEY=
CORTEX_API_KEY_ID=
# standard ou advanced. Se estiver errado, o servidor tenta o outro e avisa no log.
CORTEX_AUTH=standard
CORTEX_TLS_VERIFY=true

# --- Servidor --------------------------------------------------------------
# Só o próprio PC (a TV) abre o mapa. Não mudar para 0.0.0.0: o mapa mostra
# IPs e nomes de sites, e não tem palavra-passe.
MAPA_HOST=127.0.0.1
MAPA_PORT=8001
