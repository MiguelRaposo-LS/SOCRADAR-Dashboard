# Copiar para .env e preencher. O .env nunca vai para o git.

# --- Acesso ao ecrã --------------------------------------------------------
# Palavra-passe partilhada (HTTP Basic Auth; o nome de utilizador é ignorado).
DASHBOARD_PASSWORD=
HOST=127.0.0.1
PORT=8360
# 1 = o próprio PC (127.0.0.1) entra sem palavra-passe, para o browser em
# modo kiosk não ficar parado na janela de login depois de cada arranque. O
# resto da rede continua a precisar dela. Não ligar com um proxy na mesma
# máquina (todos os pedidos pareceriam locais).
DASHBOARD_LOCAL_NO_AUTH=0

# --- Cortex XSIAM ----------------------------------------------------------
# Consola do XSIAM → Settings → Configurations → API Keys.
# URL: botão «Copy API URL» (ex.: https://api-<tenant>.xdr.eu.paloaltonetworks.com)
# A chave precisa de um papel que leia casos E alertas — um papel que só veja
# alertas dá contadores a zero sem erro nenhum.
CORTEX_API_URL=
CORTEX_API_KEY=
CORTEX_API_KEY_ID=
# standard ou advanced: tem de ser o tipo com que a chave foi criada (um
# tipo errado dá 401 em tudo; a chave do GRA de 2026-09-29 é advanced).
CORTEX_AUTH=standard
CORTEX_TLS_VERIFY=true

# Ecrã com dados inventados, sem tenant. Aparece um aviso bem visível.
DEMO_MODE=0

# Pasta onde se grava o estado (retomado depois de um reinício). Vazio =
# ./estado ao lado do server.py. Tem nomes de casos, hosts e utilizadores.
STATE_DIR=

# --- Sincronização ---------------------------------------------------------
SYNC_INTERVAL_SECONDS=60
# Teto de páginas de 100 por recolha (cada fase da recolha inicial é uma). Se
# for atingido, o ecrã avisa que os números estão truncados.
MAX_INCIDENT_PAGES=200
MAX_ALERT_PAGES=300
TOP_ALERTS=10

# --- Briefing -------------------------------------------------------------
# Gerado por um modelo local no Ollama, no arranque e depois à hora certa.
# O modelo tem de já ter sido descarregado (ollama pull llama3.2:3b).
# Mais leve, se faltar memória: gemma2:2b.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Segundos. Sem GPU, um modelo de 3B pode precisar de mais.
OLLAMA_TIMEOUT=30
